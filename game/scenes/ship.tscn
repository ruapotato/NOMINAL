size = Vector3(34, 4, 34)

[node name="ShieldControl" type="CSGBox3D" parent="Deck3"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 58, 2, 18)
size = Vector3(26, 4, 24)

[node name="WeaponsControl" type="CSGBox3D" parent="Deck3"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 58, 2, -18)
size = Vector3(26, 4, 24)

; ---------------------------------------------------------------- SHAFTS
; Named with the deck range they serve. LiftMid is the one that matters: it is
; the only way from the engineering hull up to the deck that crosses the neck,
; so losing it splits the ship in half.

[node name="Shafts" type="Node3D" parent="."]

[node name="LiftAft_0_2" type="Marker3D" parent="Shafts"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 160, 0, 0)

[node name="LiftMid_0_3" type="Marker3D" parent="Shafts"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 108, 0, 0)

[node name="LiftFwd_2_3" type="Marker3D" parent="Shafts"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 40, 0, 0)

[node name="StairMid_1_2" type="Marker3D" parent="Shafts"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 124, 0, 0)
